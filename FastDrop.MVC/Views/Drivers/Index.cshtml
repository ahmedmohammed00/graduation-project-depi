@model IEnumerable<FastDrop.MVC.Models.Driver>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Drivers Management";
    ViewData["Subtitle"] = "Manage delivery drivers and their assignments";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus mr-2"></i> Add New Driver
    </a>
</div>

<div class="table-wrap h-100">
    <div class="table-head">
        <div class="table-title">All Drivers</div>
    </div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Driver Info</th>
                    <th>License Info</th>
                    <th>Zone & Assignment</th>
                    <th>Status</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div style="font-weight: 600; color: var(--text-dark);">@item.Name</div>
                                <div class="text-muted"><small>@item.PhoneNumber</small></div>
                            </td>
                            <td>
                                <div>@item.LicenseNumber</div>
                                @{
                                    var expiryClass = item.LicenseExpiryDate < DateTime.Now ? "text-danger" : "text-muted";
                                }
                                <div class="@expiryClass"><small>Expires: @item.LicenseExpiryDate?.ToString("MMM dd, yyyy")</small></div>
                            </td>
                            <td>
                                <div><small class="text-muted">Zone ID:</small> @(item.ZoneId.HasValue ? item.ZoneId.Value.ToString() : "N/A")</div>
                                @if(item.Employee != null)
                                {
                                    <div class="text-muted"><small>Emp ID: @item.EmployeeId</small></div>
                                }
                            </td>
                            <td>
                                @if (item.CurrentStatus?.ToLower() == "available")
                                {
                                    <span class="s-badge sb-success">@item.CurrentStatus</span>
                                }
                                else if (item.CurrentStatus?.ToLower() == "on-route")
                                {
                                    <span class="s-badge sb-warning">@item.CurrentStatus</span>
                                }
                                else if (item.CurrentStatus?.ToLower() == "inactive")
                                {
                                    <span class="s-badge sb-danger">@item.CurrentStatus</span>
                                }
                                else
                                {
                                    <span class="s-badge sb-info">@(item.CurrentStatus ?? "Unknown")</span>
                                }
                            </td>
                            <td class="text-right">
                                <a asp-action="Details" asp-route-id="@item.DriverId" class="btn btn-sm btn-info" title="View Details">
                                    View
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.DriverId" class="btn btn-sm btn-primary" title="Edit Driver">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.DriverId" class="btn btn-sm btn-danger" title="Delete Driver">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted" style="padding: 40px;">
                            No drivers found. Click 'Add New Driver' to create one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
