@model FastDrop.MVC.Models.Driver

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Driver";
    ViewData["Subtitle"] = "Are you sure you want to remove this driver?";
}

<div class="row">
    <div class="col-md-6 mx-auto">
        <div class="card shadow-sm border-0 mt-4" style="border-top: 4px solid var(--danger) !important;">
            <div class="card-body p-4 text-center">
                <div class="mb-4 text-danger">
                    <i class="fas fa-exclamation-triangle fa-4x"></i>
                </div>
                
                <h4 style="color: var(--text-dark); font-weight: 700;">Delete Driver Profile</h4>
                <p class="text-muted mb-4">
                    You are about to permanently delete the driver account for <strong>@Model.Name</strong> (ID: @Model.DriverId).
                    <br />
                    This action cannot be undone.
                </p>

                <div class="bg-light p-3 rounded text-left mb-4">
                    <div class="row mb-2">
                        <div class="col-sm-5 text-muted">Phone Number:</div>
                        <div class="col-sm-7 font-weight-bold">@Model.PhoneNumber</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-5 text-muted">License Number:</div>
                        <div class="col-sm-7 font-weight-bold">@Model.LicenseNumber</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-5 text-muted">Current Status:</div>
                        <div class="col-sm-7">
                            <span class="s-badge sb-warning">@Model.CurrentStatus</span>
                        </div>
                    </div>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="DriverId" />
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-danger px-4 py-2">
                            <i class="fas fa-trash mr-2"></i> Yes, Delete Driver
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
