@model FastDrop.MVC.Models.Driver

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Driver";
    ViewData["Subtitle"] = $"Update profile and assignments for {Model.Name}";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="DriverId" />
                    
                    <h5 class="mb-3" style="color: var(--primary);">Personal Information</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label" style="font-weight: 500;">Driver Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label" style="font-weight: 500;">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="mb-3" style="color: var(--primary);">License Details</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="LicenseNumber" class="form-label" style="font-weight: 500;">License Number</label>
                            <input asp-for="LicenseNumber" class="form-control" />
                            <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LicenseExpiryDate" class="form-label" style="font-weight: 500;">License Expiry</label>
                            <input asp-for="LicenseExpiryDate" class="form-control" type="date" />
                            <span asp-validation-for="LicenseExpiryDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="mb-3" style="color: var(--primary);">Assignments</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CurrentStatus" class="form-label" style="font-weight: 500;">Status</label>
                            <select asp-for="CurrentStatus" class="form-control">
                                <option value="available">Available</option>
                                <option value="on-route">On-Route</option>
                                <option value="inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="CurrentStatus" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ZoneId" class="form-label" style="font-weight: 500;">Assigned Zone</label>
                            <select asp-for="ZoneId" class="form-control" asp-items="ViewBag.ZoneId">
                                <option value="">-- No Zone Assigned --</option>
                            </select>
                            <span asp-validation-for="ZoneId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="VehicleId" class="form-label" style="font-weight: 500;">Assigned Vehicle</label>
                            <select id="VehicleId" name="VehicleId" class="form-control" asp-items="ViewBag.VehicleId">
                                <option value="">-- No Vehicle Assigned --</option>
                            </select>
                            <span class="text-muted small">Optional. A driver needs a vehicle to be active.</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="AddressId" class="form-label" style="font-weight: 500;">Home Base Address</label>
                            <select asp-for="AddressId" class="form-control" asp-items="ViewBag.AddressId">
                                <option value="">-- No Address --</option>
                            </select>
                            <span asp-validation-for="AddressId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EmployeeId" class="form-label" style="font-weight: 500;">Linked Employee Account</label>
                            <select asp-for="EmployeeId" class="form-control" asp-items="ViewBag.EmployeeId">
                                <option value="">-- No Employee Linked --</option>
                            </select>
                            <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            <i class="fas fa-save mr-2"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
