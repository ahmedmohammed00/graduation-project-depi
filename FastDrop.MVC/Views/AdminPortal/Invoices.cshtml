@model IEnumerable<FastDrop.MVC.Models.Invoice>
@{
    ViewData["Title"] = "Invoices";
    ViewData["Subtitle"] = "Manage Merchant Invoices";
    Layout = "_AdminLayout";
}

<div class="table-wrap" style="padding: 24px; background: white; border-radius: 16px; border: 1px solid var(--border-light); margin-bottom: 24px;">
    <h2 class="table-title" style="margin-bottom: 16px;">Generate New Invoice</h2>
    <form method="post" action="@Url.Action("CreateInvoice", "AdminPortal")" style="display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;">
        @Html.AntiForgeryToken()
        <div style="flex: 1; min-width: 200px;">
            <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-mid); margin-bottom: 8px;">Merchant</label>
            <select name="merchantId" class="form-control" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border); outline: none; font-family: inherit;" required>
                <option value="">Select Merchant</option>
                @foreach (var m in ViewBag.Merchants)
                {
                    <option value="@m.MerchantId">@m.ShopName (@m.ContactName)</option>
                }
            </select>
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-mid); margin-bottom: 8px;">Start Date</label>
            <input type="date" name="startDate" class="form-control" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border); outline: none; font-family: inherit;" required />
        </div>
        <div style="flex: 1; min-width: 150px;">
            <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-mid); margin-bottom: 8px;">End Date</label>
            <input type="date" name="endDate" class="form-control" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border); outline: none; font-family: inherit;" required />
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Generate Invoice</button>
        </div>
    </form>
</div>

<div class="table-wrap">
    <div class="table-head">
        <div class="table-title">Invoice History</div>
    </div>
    <div style="overflow-x:auto;">
        <table>
            <thead>
                <tr>
                    <th>Invoice ID</th>
                    <th>Merchant</th>
                    <th>Period</th>
                    <th>Amount Due</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><div style="font-weight:700; color:var(--text-dark)">#INV-@item.InvoiceId</div></td>
                        <td>
                            <div style="font-weight:600; color:var(--text-dark)">@item.Merchant?.ShopName</div>
                        </td>
                        <td>@item.PeriodStart?.ToString("MMM dd") - @item.PeriodEnd?.ToString("MMM dd, yyyy")</td>
                        <td><div style="font-weight:700; color:var(--text-dark)">@item.AmountDue.ToString("C")</div></td>
                        <td>
                            @if (item.PaymentStatus == "Paid")
                            {
                                <span class="s-badge sb-success">Paid</span>
                            }
                            else
                            {
                                <span class="s-badge sb-warning">Unpaid</span>
                            }
                        </td>
                    </tr>
                }
                @if(!Model.Any()){
                    <tr><td colspan="5" style="text-align:center; padding: 30px;">No invoices found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
