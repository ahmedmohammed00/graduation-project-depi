@model FastDrop.MVC.Models.Merchant

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Merchant Details";
    ViewData["Subtitle"] = "View merchant information and related shipments";
}

<div class="row">
    <!-- Merchant Info Card -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h5 class="mb-0" style="color: var(--primary); font-weight: 600;">@Model.ShopName</h5>
            </div>
            <div class="card-body">
                <p><strong>Contact Name:</strong> @(Model.ContactName ?? "N/A")</p>
                <p><strong>Email:</strong> @Model.Email</p>
                <p><strong>Phone:</strong> @(Model.Phone ?? "N/A")</p>
                <p>
                    <strong>Status:</strong> 
                    @if (Model.Status == "active")
                    {
                        <span class="s-badge sb-success">Active</span>
                    }
                    else
                    {
                        <span class="s-badge sb-warning">@Model.Status</span>
                    }
                </p>
                <hr />
                <h6>Address</h6>
                @if (Model.Address != null)
                {
                    <p class="mb-0">@Model.Address.Street, @Model.Address.District</p>
                }
                else
                {
                    <p class="text-muted mb-0">No address assigned</p>
                }
            </div>
        </div>
    </div>

    <!-- Related Shipments -->
    <div class="col-md-8 mb-4">
        <div class="table-wrap h-100">
            <div class="table-head">
                <div class="table-title">Related Shipments</div>
            </div>
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Shipment ID</th>
                            <th>Destination</th>
                            <th>COD Amount</th>
                            <th>Created At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Shipments != null && Model.Shipments.Any())
                        {
                            foreach (var shipment in Model.Shipments.OrderByDescending(s => s.CreationDate))
                            {
                                <tr>
                                    <td><div style="font-weight:700; color:var(--text-dark)">#SHP-@shipment.ShipmentId</div></td>
                                    <td>
                                        @if (shipment.Address != null)
                                        {
                                            @shipment.Address.District<br />
                                            <small class="text-muted">@shipment.Address.Street</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div style="font-weight:700; color:var(--text-dark)">@((shipment.CodAmount).ToString("C"))</div>
                                    </td>
                                    <td>@shipment.CreationDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <a href="@Url.Action("ShipmentDetails", "AdminPortal", new { id = shipment.ShipmentId })" class="btn btn-secondary btn-sm">View</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center" style="padding: 30px; color: var(--text-muted);">
                                    No shipments found for this merchant.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a href="@Url.Action("Merchants", "AdminPortal")" class="btn btn-secondary">Back to Merchants</a>
</div>
