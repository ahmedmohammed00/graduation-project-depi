@model FastDrop.MVC.Models.Zone

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Zone";
}

@section Styles {
<style>
.zone-form { max-width: 640px; margin: 0 auto; }
.form-card { background: white; border-radius: 16px; border: 1px solid var(--border-light); padding: 32px; animation: fadeUp .35s ease both; }
.card-header { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; padding-bottom: 18px; border-bottom: 1px solid var(--border-light); }
.card-icon { width: 42px; height: 42px; background: linear-gradient(135deg, var(--info), #2563eb); border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.card-icon svg { width: 22px; height: 22px; fill: white; }
.card-title h3 { font-size: 17px; font-weight: 800; color: var(--text-dark); }
.card-title p { font-size: 12px; color: var(--text-muted); margin-top: 3px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-row.full { grid-template-columns: 1fr; }
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; }
.field label { font-size: 12px; font-weight: 700; color: var(--text-mid); text-transform: uppercase; letter-spacing: .04em; }
.field input { width: 100%; border: 1.5px solid var(--border-light); border-radius: 10px; padding: 11px 14px; font-size: 14px; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--text-dark); outline: none; transition: all .2s; background: white; }
.field input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(0,201,167,.1); }
.field small { font-size: 11px; color: var(--text-muted); }
.form-actions { display: flex; align-items: center; gap: 12px; padding-top: 20px; border-top: 1px solid var(--border-light); margin-top: 8px; }
</style>
}

<div class="zone-form">
    <div class="form-card">
        <div class="card-header">
            <div class="card-icon">
                <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
            </div>
            <div class="card-title">
                <h3>Edit Zone — @Model.Name</h3>
                <p>Update delivery pricing and configuration</p>
            </div>
        </div>

        <form asp-action="EditZone" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ZoneId" />

            <div class="form-row full">
                <div class="field">
                    <label>Zone Name</label>
                    <input asp-for="Name" required />
                </div>
            </div>
            <div class="form-row">
                <div class="field">
                    <label>Delivery Fee (EGP)</label>
                    <input asp-for="DeliveryFee" type="number" step="0.01" required />
                </div>
                <div class="field">
                    <label>Base COD Amount (EGP)</label>
                    <input asp-for="CodAmount" type="number" step="0.01" required />
                    <small>Auto-added to every shipment's COD in this zone</small>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" style="padding: 12px 28px;">
                    <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:white;"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                    Save Changes
                </button>
                <a asp-action="Zones" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
