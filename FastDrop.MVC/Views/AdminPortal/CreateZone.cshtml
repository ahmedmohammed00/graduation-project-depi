@model FastDrop.MVC.Models.Zone

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Zone";
}

@section Styles {
<style>
.zone-form { max-width: 640px; margin: 0 auto; }
.form-card { background: white; border-radius: 16px; border: 1px solid var(--border-light); padding: 32px; animation: fadeUp .35s ease both; }
.card-header { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; padding-bottom: 18px; border-bottom: 1px solid var(--border-light); }
.card-icon { width: 42px; height: 42px; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.card-icon svg { width: 22px; height: 22px; fill: white; }
.card-title h3 { font-size: 17px; font-weight: 800; color: var(--text-dark); }
.card-title p { font-size: 12px; color: var(--text-muted); margin-top: 3px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-row.full { grid-template-columns: 1fr; }
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; }
.field label { font-size: 12px; font-weight: 700; color: var(--text-mid); text-transform: uppercase; letter-spacing: .04em; }
.field input, .field select { width: 100%; border: 1.5px solid var(--border-light); border-radius: 10px; padding: 11px 14px; font-size: 14px; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--text-dark); outline: none; transition: all .2s; background: white; }
.field input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(0,201,167,.1); }
.field small { font-size: 11px; color: var(--text-muted); }
.check-field { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
.check-field input[type="checkbox"] { width: 20px; height: 20px; accent-color: var(--primary); cursor: pointer; }
.check-field label { font-size: 13px; font-weight: 600; color: var(--text-mid); cursor: pointer; }
.form-actions { display: flex; align-items: center; gap: 12px; padding-top: 8px; border-top: 1px solid var(--border-light); margin-top: 8px; padding-top: 20px; }
</style>
}

<div class="zone-form">
    <div class="form-card">
        <div class="card-header">
            <div class="card-icon">
                <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            </div>
            <div class="card-title">
                <h3>Add New Zone</h3>
                <p>Define a delivery zone with pricing and boundaries</p>
            </div>
        </div>

        <form asp-action="CreateZone" method="post">
            @Html.AntiForgeryToken()

            <div class="form-row full">
                <div class="field">
                    <label>Zone Name</label>
                    <input asp-for="Name" placeholder="e.g. Cairo Downtown" required />
                </div>
            </div>
            <div class="form-row">
                <div class="field">
                    <label>City</label>
                    <input asp-for="City" placeholder="e.g. Cairo" />
                </div>
                <div class="field">
                    <label>Delivery Fee (EGP)</label>
                    <input asp-for="DeliveryFee" type="number" step="0.01" placeholder="0.00" />
                </div>
            </div>
            <div class="form-row">
                <div class="field">
                    <label>Base COD Amount (EGP)</label>
                    <input asp-for="CodAmount" type="number" step="0.01" placeholder="0.00" />
                    <small>Auto-added to every shipment's COD in this zone</small>
                </div>
                <div style="display: flex; align-items: flex-end; padding-bottom: 18px;">
                    <div class="check-field">
                        <input asp-for="ActiveStatus" type="checkbox" id="activeStatus" />
                        <label for="activeStatus">Active Zone</label>
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" style="padding: 12px 28px;">
                    <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:white;"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                    Create Zone
                </button>
                <a asp-action="Zones" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
