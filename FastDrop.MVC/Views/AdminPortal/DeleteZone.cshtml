@model FastDrop.MVC.Models.Zone

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Zone";
}

<div class="table-wrap" style="padding: 24px; max-width: 600px; margin: 0 auto; text-align: center;">
    <div style="color: var(--error); margin-bottom: 20px;">
        <svg viewBox="0 0 24 24" style="width: 64px; height: 64px; fill: currentColor;">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
        </svg>
    </div>
    
    <h3 class="table-title">Delete Zone</h3>
    <p style="color: var(--text-muted); margin-bottom: 24px;">
        Are you sure you want to delete this zone? This action cannot be undone and may affect addresses using this zone.
    </p>

    <div style="background: var(--error-light); border: 1px solid var(--error); border-radius: 8px; padding: 20px; text-align: left; margin-bottom: 24px;">
        <p><strong>Zone Name:</strong> @Model.Name</p>
        <p><strong>Delivery Fee:</strong> @Model.DeliveryFee</p>
        <p><strong>Base COD:</strong> @Model.CodAmount.ToString("C")</p>
    </div>

    <form asp-action="DeleteZone" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ZoneId" />
        <button type="submit" class="btn btn-primary" style="background: var(--error);">Yes, Delete Zone</button>
        <a asp-action="Zones" class="btn btn-secondary" style="margin-left: 10px;">Cancel</a>
    </form>
</div>
