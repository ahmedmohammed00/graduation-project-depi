@model IEnumerable<FastDrop.MVC.Models.Product>
@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_MerchantLayout.cshtml";
}

<div class="table-wrap">
    <div class="table-head">
        <h3 class="table-title">My Products</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg> Add Product
        </a>
    </div>
    <table>
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Total Stock</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td style="font-weight: 600; color: var(--text-dark);">@item.Name</td>
                    <td>@(item.Description ?? "-")</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>
                        @if (item.StockQuantity > 0) {
                            <span class="s-badge sb-success">@item.StockQuantity in stock</span>
                        } else {
                            <span class="s-badge sb-error">Out of Stock</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-secondary btn-sm" style="padding: 4px 8px;">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-secondary btn-sm" style="padding: 4px 8px; color: var(--error);">Delete</a>
                    </td>
                </tr>
            }
            @if(!Model.Any()) {
                <tr>
                    <td colspan="5" style="text-align: center; padding: 24px;">No products found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
