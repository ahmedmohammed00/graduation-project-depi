@model FastDrop.MVC.Models.Product
@{
    ViewData["Title"] = "Delete Product";
    Layout = "~/Views/Shared/_MerchantLayout.cshtml";
}

<div class="table-wrap" style="max-width: 600px; margin: 40px auto; padding: 30px;">
    <h3 class="table-title" style="margin-bottom: 24px; color: var(--error);">Delete Product</h3>
    
    <div style="background: var(--error-light); padding: 16px; border-radius: 8px; border: 1px solid rgba(239,68,68,0.2); margin-bottom: 24px;">
        <p style="margin: 0; color: var(--error); font-weight: 600;">Are you sure you want to delete this product?</p>
        <p style="margin: 4px 0 0 0; font-size: 13px; color: var(--error);">This action cannot be undone.</p>
    </div>

    <dl style="display: grid; grid-template-columns: 140px 1fr; gap: 12px 0; margin-bottom: 32px;">
        <dt style="font-size: 12px; font-weight: 600; color: var(--text-muted);">Product Name</dt>
        <dd style="margin: 0; font-weight: 600; color: var(--text-dark);">@Model.Name</dd>
        
        <dt style="font-size: 12px; font-weight: 600; color: var(--text-muted);">Price</dt>
        <dd style="margin: 0;">@Model.Price.ToString("C")</dd>

        <dt style="font-size: 12px; font-weight: 600; color: var(--text-muted);">Total Stock</dt>
        <dd style="margin: 0;">@Model.StockQuantity</dd>
    </dl>
    
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="ProductId" />
        <div style="display: flex; justify-content: flex-end; gap: 12px;">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn" style="background: var(--error); color: white;">Confirm Delete</button>
        </div>
    </form>
</div>
