@model FastDrop.MVC.Models.Product

@{
    ViewData["Title"] = "Add Product";
    Layout = "~/Views/Shared/_MerchantLayout.cshtml";
    var warehouses = ViewBag.Warehouses as IEnumerable<FastDrop.MVC.Models.Warehouse>;
}

<div class="table-wrap" style="max-width: 600px; margin: 40px auto; padding: 30px;">
    <h3 class="table-title" style="margin-bottom: 24px;">Add New Product</h3>
    
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="Name">Product Name *</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger" style="font-size: 12px; color: var(--error);"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Price">Price</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" required />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MerchantId">Merchant</label>
            <select asp-for="MerchantId" class="form-control" asp-items="ViewBag.MerchantId"></select>
            <span class="text-muted" style="font-size:12px;">This is temporary for dev. In prod, this will be auto-assigned.</span>
        </div>

        <h4 style="margin: 32px 0 16px 0; font-size: 16px; color: var(--text-dark);">Stock Allocation (By Warehouse)</h4>
        
        <div style="background: var(--bg-color); border: 1px solid var(--border); border-radius: 8px; padding: 16px;">
            @if (warehouses != null && warehouses.Any())
            {
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border);">
                            <th style="text-align: left; padding: 8px 0; font-size: 13px; color: var(--text-muted);">Warehouse</th>
                            <th style="text-align: right; padding: 8px 0; font-size: 13px; color: var(--text-muted); width: 120px;">Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var warehouse in warehouses)
                        {
                            <tr style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 12px 0; font-weight: 500; font-size: 14px;">
                                    @warehouse.WarehouseName
                                    <input type="hidden" name="WarehouseIds" value="@warehouse.WarehouseId" />
                                </td>
                                <td style="padding: 12px 0; text-align: right;">
                                    <input type="number" name="Quantities" class="form-control" style="width: 100px; display: inline-block; text-align: right;" min="0" value="0" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="margin: 0; font-size: 14px; color: var(--text-muted);">No warehouses available.</p>
            }
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px;">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Product</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
