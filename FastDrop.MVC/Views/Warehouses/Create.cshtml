@model FastDrop.MVC.Models.Warehouse

@{
    ViewData["Title"] = "Add Warehouse";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="table-wrap" style="max-width: 600px; margin: 40px auto; padding: 30px;">
    <h3 class="table-title" style="margin-bottom: 24px;">Add New Warehouse</h3>
    
    <form asp-action="Create" method="post">
        <div class="form-group">
            <label asp-for="WarehouseName">Warehouse Name *</label>
            <input asp-for="WarehouseName" class="form-control" required />
            <span asp-validation-for="WarehouseName" class="text-danger" style="font-size: 12px; color: var(--error);"></span>
        </div>

        <div class="form-group">
            <label asp-for="AddressId">Address</label>
            <select asp-for="AddressId" class="form-control" asp-items="ViewBag.AddressId">
                <option value="">-- Select Address --</option>
            </select>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px;">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Warehouse</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
