@model IEnumerable<FastDrop.MVC.Models.Warehouse>

@{
    ViewData["Title"] = "Warehouses";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="table-wrap">
    <div class="table-head">
        <h3 class="table-title">Warehouses</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg> Add Warehouse
        </a>
    </div>
    <table>
        <thead>
            <tr>
                <th>Warehouse Name</th>
                <th>Address ID</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td style="font-weight: 600; color: var(--text-dark);">@item.WarehouseName</td>
                    <td>@item.AddressId</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.WarehouseId" class="btn btn-secondary btn-sm" style="padding: 4px 8px;">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.WarehouseId" class="btn btn-secondary btn-sm" style="padding: 4px 8px; color: var(--error);">Delete</a>
                    </td>
                </tr>
            }
            @if(!Model.Any()) {
                <tr>
                    <td colspan="3" style="text-align: center; padding: 24px;">No warehouses found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
