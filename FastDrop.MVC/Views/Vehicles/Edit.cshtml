@model FastDrop.MVC.Models.Vehicle
@{
    ViewData["Title"] = "Edit Vehicle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="table-wrap" style="max-width: 600px; margin: 40px auto; padding: 30px;">
    <h3 class="table-title" style="margin-bottom: 24px;">Edit Vehicle</h3>
    
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="VehicleId" />

        <div class="form-group">
            <label asp-for="LicensePlate">License Plate *</label>
            <input asp-for="LicensePlate" class="form-control" required />
            <span asp-validation-for="LicensePlate" class="text-danger" style="font-size: 12px; color: var(--error);"></span>
        </div>

        <div class="form-group">
            <label asp-for="Model">Vehicle Model</label>
            <input asp-for="Model" class="form-control" placeholder="e.g., Ford Transit 2021" />
        </div>

        <div class="form-group">
            <label asp-for="VehicleType">Vehicle Type</label>
            <input asp-for="VehicleType" class="form-control" placeholder="e.g., Van, Truck, Motorcycle" />
        </div>

        <div class="form-group">
            <label asp-for="MaxCapacityKg">Max Capacity (Kg)</label>
            <input asp-for="MaxCapacityKg" class="form-control" type="number" step="0.01" />
        </div>

        <div class="form-group">
            <label asp-for="LicenseExpiryDate">License Expiry Date</label>
            <input asp-for="LicenseExpiryDate" class="form-control" type="date" />
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px;">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
