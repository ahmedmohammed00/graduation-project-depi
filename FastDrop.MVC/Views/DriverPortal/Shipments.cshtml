@model IEnumerable<FastDrop.MVC.Models.Shipment>

@{
    Layout = "_DriverLayout";
    ViewData["Title"] = "Shipments";
    ViewData["Subtitle"] = "All shipments across your routes";
}

<div class="table-wrap">
    <div class="table-head">
        <div class="table-title">Shipments</div>
    </div>
    <div style="overflow-x:auto">
        <table>
            <thead>
                <tr>
                    <th>Shipment ID</th>
                    <th>Route ID</th>
                    <th>Destination</th>
                    <th>COD Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shipment in Model)
                {
                    var latestStatus = shipment.ShipmentStatuses.OrderByDescending(s => s.UpdatedAt).FirstOrDefault();
                    var statusName = latestStatus?.Status ?? "Pending";
                    var badgeClass = "sb-pending";
                    if (statusName.Equals("Delivered", StringComparison.OrdinalIgnoreCase)) badgeClass = "sb-delivered";
                    else if (statusName.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)) badgeClass = "sb-cancelled";
                    else if (statusName.Equals("Failed", StringComparison.OrdinalIgnoreCase)) badgeClass = "sb-failed";
                    else if (statusName.Equals("In Transit", StringComparison.OrdinalIgnoreCase) || statusName.Equals("Dispatched", StringComparison.OrdinalIgnoreCase)) badgeClass = "sb-active";

                    <tr>
                        <td style="font-weight:700; color:var(--primary)">#@shipment.ShipmentId</td>
                        <td>@(shipment.RouteId.HasValue ? $"#RT-{shipment.RouteId}" : "-")</td>
                        <td>
                            @if(shipment.Address != null)
                            {
                                <div>@shipment.Address.Street</div>
                                <div style="font-size:11px; color:var(--text-muted);">@shipment.Address.District</div>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td style="font-weight:600">@shipment.CodAmount.ToString("C")</td>
                        <td><span class="s-badge @badgeClass">@statusName</span></td>
                        <td>
                            @if (!statusName.Equals("Delivered", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@Url.Action("UpdateStatus", "DriverPortal", new { id = shipment.ShipmentId })" class="btn btn-primary btn-sm">
                                    Update Status
                                </a>
                            }
                            else
                            {
                                <span style="font-size: 12px; color: var(--text-muted);"><svg viewBox="0 0 24 24" style="width:14px; fill:var(--success); vertical-align:middle;"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> Completed</span>
                            }
                        </td>
                    </tr>
                }
                
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 24px; color: var(--text-muted);">
                            No shipments found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
