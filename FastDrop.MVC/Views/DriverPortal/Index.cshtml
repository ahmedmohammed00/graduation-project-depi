@{
    Layout = "_DriverLayout";
    ViewData["Title"] = "Overview";
    var perf = ViewBag.DriverPerformance as FastDrop.MVC.Models.PerformanceScore;
    var score = perf?.DailyScore ?? 0m;
    var progress = Math.Clamp(score, 0m, 100m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
<div class="overview-heading"><div><p class="eyebrow">Your driver workspace</p><h1>Ready for the road<span style="color:var(--primary)">?</span></h1><p class="page-description">Your routes, deliveries and earnings. All in one clear view.</p></div><a class="btn btn-primary" asp-action="Shipments">My deliveries @await Html.PartialAsync("_PortalIcon", "arrow")</a></div>
<section class="metric-grid" aria-label="Delivery summary">
    <article class="metric-card"><div class="metric-topline"><span class="metric-label">Active routes</span><span class="metric-symbol">@await Html.PartialAsync("_PortalIcon", "route")</span></div><div class="metric-value">@ViewBag.ActiveRoutesCount</div><p class="metric-footnote">Your assigned routes</p></article>
    <article class="metric-card"><div class="metric-topline"><span class="metric-label">Assigned shipments</span><span class="metric-symbol">@await Html.PartialAsync("_PortalIcon", "box")</span></div><div class="metric-value">@ViewBag.TotalShipments</div><p class="metric-footnote">Deliveries in your workspace</p></article>
    <article class="metric-card is-featured"><div class="metric-topline"><span class="metric-label">Delivered</span><span class="metric-symbol">@await Html.PartialAsync("_PortalIcon", "check")</span></div><div class="metric-value">@ViewBag.DeliveredShipments</div><p class="metric-footnote">Completed shipments</p></article>
    <article class="metric-card"><div class="metric-topline"><span class="metric-label">Pending delivery</span><span class="metric-symbol">@await Html.PartialAsync("_PortalIcon", "clock")</span></div><div class="metric-value">@ViewBag.PendingShipments</div><p class="metric-footnote">Still on your delivery list</p></article>
</section>
<div class="dashboard-grid"><section class="panel"><div class="panel-head"><h2 class="panel-title">Your next stop</h2><span class="s-badge sb-active">On the move</span></div><div class="panel-body"><p class="eyebrow">One delivery at a time</p><h2 style="font-size:23px;margin-bottom:12px">A good day starts with a clear route.</h2><p class="page-description" style="margin-bottom:24px">Check your assigned routes, review delivery addresses and keep your shipment status up to date.</p><a class="btn btn-primary" asp-action="Routes">View my routes @await Html.PartialAsync("_PortalIcon", "arrow")</a></div></section>
<section class="panel"><div class="panel-head"><h2 class="panel-title">Your performance</h2><span class="s-badge sb-active">@(perf?.Tier ?? "Unranked")</span></div><div class="panel-body"><div class="performance-panel"><div><p class="page-description">Current score</p><div class="performance-score">@score.ToString("0.#")<small> / 100</small></div></div><span class="shortcut-icon">@await Html.PartialAsync("_PortalIcon", "chart")</span></div><div class="performance-track" role="meter" aria-label="Current performance score" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"><span style="width:@(progress)%"></span></div><p class="legend-caption">Calculated from your delivery and feedback history.</p></div></section></div>
<div class="shortcut-grid"><a class="shortcut-card" asp-action="Routes"><span class="shortcut-icon">@await Html.PartialAsync("_PortalIcon", "route")</span><div><h3>Your routes</h3><p>See the stops assigned to you.</p></div>@await Html.PartialAsync("_PortalIcon", "external")</a><a class="shortcut-card" asp-action="Shipments"><span class="shortcut-icon">@await Html.PartialAsync("_PortalIcon", "truck")</span><div><h3>Your deliveries</h3><p>Review shipment and delivery details.</p></div>@await Html.PartialAsync("_PortalIcon", "external")</a><a class="shortcut-card" asp-action="Payments"><span class="shortcut-icon">@await Html.PartialAsync("_PortalIcon", "wallet")</span><div><h3>Your earnings</h3><p>Keep track of pending and paid earnings.</p></div>@await Html.PartialAsync("_PortalIcon", "external")</a></div>
