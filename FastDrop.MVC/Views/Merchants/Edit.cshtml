@model FastDrop.MVC.ViewModels.MerchantEditViewModel

@{
    ViewData["Title"] = "Edit Merchant";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="table-wrap" style="max-width: 600px; margin: 40px auto; padding: 30px;">
    <h3 class="table-title" style="margin-bottom: 24px;">Edit Merchant</h3>
    
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="MerchantId" />

        <div class="form-group">
            <label asp-for="ShopName">Shop Name *</label>
            <input asp-for="ShopName" class="form-control" required />
            <span asp-validation-for="ShopName" class="text-danger" style="font-size: 12px; color: var(--error);"></span>
        </div>

        <div class="form-group">
            <label asp-for="ContactName">Contact Name *</label>
            <input asp-for="ContactName" class="form-control" required />
            <span asp-validation-for="ContactName" class="text-danger" style="font-size: 12px; color: var(--error);"></span>
        </div>

        <div class="form-group">
            <label asp-for="Phone">Phone Number</label>
            <input asp-for="Phone" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="Email">Email Address *</label>
            <input asp-for="Email" type="email" class="form-control" required />
            <span asp-validation-for="Email" class="text-danger" style="font-size: 12px; color: var(--error);"></span>
        </div>

        <div class="form-group">
            <label asp-for="Status">Status</label>
            <select asp-for="Status" class="form-control">
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
                <option value="pending">Pending</option>
            </select>
        </div>
        
        <div class="form-group">
            <label asp-for="AddressId">Address</label>
            <select asp-for="AddressId" class="form-control" asp-items="ViewBag.AddressId">
                <option value="">-- Select Address --</option>
            </select>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 32px;">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
