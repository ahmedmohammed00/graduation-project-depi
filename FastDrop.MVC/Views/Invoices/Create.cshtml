@model FastDrop.MVC.Models.Invoice

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Invoice</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Generate" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label class="control-label">Select Merchant</label>
                <select name="merchantId" class ="form-control" asp-items="ViewBag.MerchantId"></select>
            </div>
            
            <div class="form-group mb-3">
                <label class="control-label">Number of Recent Shipments to Invoice</label>
                <input type="number" name="shipmentCount" class="form-control" value="10" min="1" max="1000" />
            </div>

            <div class="form-group">
                <input type="submit" value="Generate Invoice" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
