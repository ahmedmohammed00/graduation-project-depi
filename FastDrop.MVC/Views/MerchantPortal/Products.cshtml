@model IEnumerable<FastDrop.MVC.Models.Product>

@{
    Layout = "_MerchantLayout";
    ViewData["Title"] = "My Products";
}

<div class="table-wrap" style="padding: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3 class="table-title" style="margin: 0;">My Products</h3>
        <a asp-action="AddProduct" class="btn btn-primary">+ Add New Product</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Price (EGP)</th>
                <th>Stock Quantity</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if(Model != null && Model.Any())
            {
                foreach(var product in Model)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>@product.StockQuantity</td>
                        <td>
                            <a href="#" class="btn btn-secondary">Edit</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center" style="padding: 40px; color: var(--text-light);">
                        No products found. Start by adding a new product.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
