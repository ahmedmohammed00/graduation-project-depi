@model FastDrop.MVC.Models.Product

@{
    Layout = "_MerchantLayout";
    ViewData["Title"] = "Add New Product";
}

<div class="table-wrap" style="padding: 24px; max-width: 600px; margin: 0 auto;">
    <h3 class="table-title">Add New Product</h3>
    <form asp-action="AddProduct" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group" style="margin-bottom: 15px;">
            <label>Product Name *</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label>Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label>Price (EGP) *</label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" required />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group" style="margin-bottom: 15px;">
            <label>Initial Stock Quantity *</label>
            <input asp-for="StockQuantity" type="number" class="form-control" value="0" required />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
        </div>

        <div class="form-group mt-4">
            <button type="submit" class="btn btn-primary">Create Product</button>
            <a asp-action="Products" class="btn btn-secondary" style="margin-left: 10px;">Cancel</a>
        </div>
    </form>
</div>
