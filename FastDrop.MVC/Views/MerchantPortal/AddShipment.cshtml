@model FastDrop.MVC.ViewModels.AddShipmentViewModel

@{
    Layout = "_MerchantLayout";
    ViewData["Title"] = "Add New Shipment";
}

<style>
.ship-form { max-width: 780px; margin: 0 auto; }
.step { background: white; border-radius: 16px; border: 1px solid var(--border); padding: 28px; margin-bottom: 20px; animation: fadeUp .35s ease both; }
.step-header { display: flex; align-items: center; gap: 14px; margin-bottom: 22px; padding-bottom: 16px; border-bottom: 1px solid var(--border-light); }
.step-num { width: 36px; height: 36px; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 15px; flex-shrink: 0; }
.step-info h4 { font-size: 15px; font-weight: 700; color: var(--text-dark); }
.step-info p { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-row.full { grid-template-columns: 1fr; }
.field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
.field label { font-size: 12px; font-weight: 700; color: var(--text-mid); text-transform: uppercase; letter-spacing: .04em; }
.field input, .field select { width: 100%; border: 1.5px solid var(--border); border-radius: 10px; padding: 11px 14px; font-size: 14px; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--text-dark); outline: none; transition: all .2s; background: white; }
.field input:focus, .field select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(0,201,167,.1); }
.field small { font-size: 11px; color: var(--text-muted); }

.product-table { width: 100%; border-collapse: separate; border-spacing: 0; border-radius: 12px; overflow: hidden; border: 1px solid var(--border-light); }
.product-table thead th { padding: 10px 14px; font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .05em; background: var(--border-light); text-align: left; }
.product-table tbody td { padding: 12px 14px; font-size: 13px; color: var(--text-mid); border-bottom: 1px solid var(--border-light); vertical-align: middle; }
.product-table tbody tr:last-child td { border-bottom: none; }
.product-table tbody tr:hover { background: #f9fafb; }
.product-check { width: 20px; height: 20px; accent-color: var(--primary); cursor: pointer; }
.product-qty { width: 70px; padding: 6px 8px !important; text-align: center; border-radius: 8px !important; }

.info-box { display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px; background: linear-gradient(135deg, var(--primary-light), rgba(0,201,167,.05)); border: 1px solid var(--primary-mid); border-radius: 12px; }
.info-box svg { width: 20px; height: 20px; fill: var(--primary-dark); flex-shrink: 0; margin-top: 1px; }
.info-box span { font-size: 13px; color: var(--primary-dark); line-height: 1.5; }

.empty-products { padding: 30px; text-align: center; border: 2px dashed var(--border); border-radius: 12px; color: var(--text-muted); }
.empty-products a { color: var(--primary); font-weight: 600; text-decoration: underline; }

.form-actions { display: flex; align-items: center; gap: 12px; padding-top: 8px; }
</style>

<form asp-action="AddShipment" method="post">
    @Html.AntiForgeryToken()
    <div class="ship-form">

        <!-- Step 1: Destination -->
        <div class="step">
            <div class="step-header">
                <div class="step-num">1</div>
                <div class="step-info">
                    <h4>Delivery Destination</h4>
                    <p>Where should this shipment be delivered?</p>
                </div>
            </div>
            <div class="form-row">
                <div class="field">
                    <label>Street Address</label>
                    <input asp-for="Shipment.Address.Street" placeholder="e.g. 15 Tahrir Street" required />
                </div>
                <div class="field">
                    <label>District</label>
                    <input asp-for="Shipment.Address.District" placeholder="e.g. Downtown" required />
                </div>
            </div>
            <div class="form-row full">
                <div class="field">
                    <label>Delivery Zone</label>
                    <select asp-for="Shipment.Address.ZoneId" required>
                        <option value="">— Select delivery zone —</option>
                        @if(ViewBag.Zones != null)
                        {
                            foreach(var zone in ViewBag.Zones)
                            {
                                <option value="@zone.ZoneId">@zone.Name — Delivery fee: @zone.DeliveryFee.ToString("C")</option>
                            }
                        }
                    </select>
                    <small>The COD and delivery fee are determined by the zone</small>
                </div>
            </div>
        </div>

        <!-- Step 2: Products -->
        <div class="step">
            <div class="step-header">
                <div class="step-num">2</div>
                <div class="step-info">
                    <h4>Select Products</h4>
                    <p>Choose which products to include in this shipment</p>
                </div>
            </div>

            @if (Model.SelectedProducts != null && Model.SelectedProducts.Any())
            {
                <table class="product-table">
                    <thead>
                        <tr>
                            <th style="width:50px; text-align:center;">Ship</th>
                            <th>Product Name</th>
                            <th>Unit Price</th>
                            <th style="width:90px;">Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.SelectedProducts.Count; i++)
                        {
                            <tr>
                                <td style="text-align:center;">
                                    <input type="hidden" asp-for="SelectedProducts[i].ProductId" />
                                    <input type="hidden" asp-for="SelectedProducts[i].ProductName" />
                                    <input type="hidden" asp-for="SelectedProducts[i].Price" />
                                    <input type="checkbox" asp-for="SelectedProducts[i].IsSelected" class="product-check" />
                                </td>
                                <td style="font-weight:600; color:var(--text-dark);">@Model.SelectedProducts[i].ProductName</td>
                                <td>@Model.SelectedProducts[i].Price.ToString("C")</td>
                                <td>
                                    <input type="number" asp-for="SelectedProducts[i].Quantity" class="field product-qty" min="1" max="@Model.SelectedProducts[i].StockQuantity" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-products">
                    <svg viewBox="0 0 24 24" style="width:40px;height:40px;fill:var(--border);margin-bottom:8px;"><path d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"/></svg>
                    <p>No products yet. <a href="@Url.Action("AddProduct", "MerchantPortal")">Add products</a> to start shipping.</p>
                </div>
            }
        </div>

        <!-- Step 3: Summary -->
        <div class="step">
            <div class="step-header">
                <div class="step-num">3</div>
                <div class="step-info">
                    <h4>Pricing & Confirmation</h4>
                    <p>Review and submit your shipment</p>
                </div>
            </div>
            <div class="info-box">
                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                <span>
                    <strong>COD is auto-calculated</strong> — The Cash on Delivery amount equals the zone's base COD + total value of selected products. You will be charged per shipment attempt, not on delivery.
                </span>
            </div>
            <div class="form-actions" style="margin-top: 20px;">
                <button type="submit" class="btn btn-primary" style="padding: 12px 28px; font-size: 14px;">
                    <svg viewBox="0 0 24 24"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z"/></svg>
                    Create Shipment
                </button>
                <a href="@Url.Action("Shipments", "MerchantPortal")" class="btn btn-secondary">Cancel</a>
            </div>
        </div>

    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
