@model FastDrop.MVC.Models.Shipment

@{
    Layout = "_MerchantLayout";
    ViewData["Title"] = "Add New Shipment";
}

<div class="table-wrap" style="padding: 24px;">
    <h3 class="table-title" style="margin-bottom: 20px;">Shipment Details</h3>
    <form asp-action="AddShipment" method="post">
        @Html.AntiForgeryToken()
        
        <div class="form-grid" style="max-width: 800px;">
            <div class="form-group full">
                <label>Destination Address *</label>
                <select asp-for="AddressId" class="form-control" required>
                    <option value="">-- Select Address --</option>
                    @if(ViewBag.Addresses != null)
                    {
                        foreach(var address in ViewBag.Addresses)
                        {
                            <option value="@address.AddressId">@address.StreetLine1, @address.City (Zone: @address.Zone?.Name)</option>
                        }
                    }
                </select>
                <span asp-validation-for="AddressId" class="text-danger" style="font-size:12px; color:var(--error)"></span>
            </div>

            <div class="form-group">
                <label>Weight (kg)</label>
                <input asp-for="WeightKg" type="number" step="0.01" class="form-control" placeholder="e.g. 2.5">
                <span asp-validation-for="WeightKg" class="text-danger" style="font-size:12px; color:var(--error)"></span>
            </div>

            <div class="form-group">
                <label>COD Amount (Cash on Delivery) *</label>
                <input asp-for="CodAmount" type="number" step="0.01" class="form-control" placeholder="0.00" required>
                <span asp-validation-for="CodAmount" class="text-danger" style="font-size:12px; color:var(--error)"></span>
            </div>

            <div class="form-group full" style="margin-top: 16px;">
                <button type="submit" class="btn btn-primary">
                    <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg> Create Shipment
                </button>
                <a href="@Url.Action("Shipments", "MerchantPortal")" class="btn btn-secondary" style="margin-left: 8px;">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
