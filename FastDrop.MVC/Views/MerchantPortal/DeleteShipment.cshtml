@model FastDrop.MVC.Models.Shipment

@{
    Layout = "_MerchantLayout";
    ViewData["Title"] = "Delete Shipment";
}

<div class="table-wrap" style="padding: 24px; max-width: 600px; margin: 0 auto; text-align: center;">
    <div style="color: var(--error); margin-bottom: 20px;">
        <svg viewBox="0 0 24 24" style="width: 64px; height: 64px; fill: currentColor;">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
        </svg>
    </div>
    
    <h3 class="table-title">Delete Shipment</h3>
    <p style="color: var(--text-muted); margin-bottom: 24px;">
        Are you sure you want to delete this shipment? This action cannot be undone.
    </p>

    <div style="background: var(--error-light); border: 1px solid var(--error); border-radius: 8px; padding: 20px; text-align: left; margin-bottom: 24px;">
        <p><strong>Shipment ID:</strong> @Model.ShipmentId</p>
        <p><strong>Destination:</strong> @Model.Address?.Street, @Model.Address?.District</p>
        <p><strong>COD Amount:</strong> @Model.CodAmount.ToString("C")</p>
    </div>

    <form asp-action="DeleteShipment" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ShipmentId" />
        <button type="submit" class="btn btn-primary" style="background: var(--error);">Yes, Delete Shipment</button>
        <a asp-action="Shipments" class="btn btn-secondary" style="margin-left: 10px;">Cancel</a>
    </form>
</div>
