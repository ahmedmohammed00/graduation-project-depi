@{
    Layout = "_MerchantLayout";
    ViewData["Title"] = "Overview";
}
<div class="overview-heading"><div><p class="eyebrow">Your merchant workspace</p><h1>Your store, in motion<span style="color:var(--primary)">.</span></h1><p class="page-description">Less time keeping track. More time growing your business.</p></div><a class="btn btn-primary" asp-action="AddShipment">@await Html.PartialAsync("_PortalIcon", "plus") New shipment</a></div>
<section class="metric-grid three-columns" aria-label="Merchant summary">
    <article class="metric-card is-featured"><div class="metric-topline"><span class="metric-label">Total shipments</span><span class="metric-symbol">@await Html.PartialAsync("_PortalIcon", "truck")</span></div><div class="metric-value">@ViewBag.TotalShipments</div><p class="metric-footnote">Every order, in one place</p></article>
    <article class="metric-card"><div class="metric-topline"><span class="metric-label">Total cash on delivery</span><span class="metric-symbol">@await Html.PartialAsync("_PortalIcon", "wallet")</span></div><div class="metric-value" style="font-size:26px"><small style="font-size:11px;letter-spacing:0">EGP</small> @ViewBag.TotalCodAmount.ToString("N0")</div><p class="metric-footnote">COD value across your shipments</p></article>
    <article class="metric-card"><div class="metric-topline"><span class="metric-label">Unpaid invoices</span><span class="metric-symbol">@await Html.PartialAsync("_PortalIcon", "invoice")</span></div><div class="metric-value">@ViewBag.PendingInvoicesCount</div><p class="metric-footnote">Your outstanding invoice queue</p></article>
</section>
<section class="overview-banner" style="margin-bottom:30px;padding:30px"><div><p class="eyebrow">Ready when you are</p><h2>Your next delivery starts here.</h2><p>Create a shipment, choose your products and let your delivery journey begin.</p></div><a class="btn btn-primary" asp-action="AddShipment">Create a shipment @await Html.PartialAsync("_PortalIcon", "arrow")</a></section>
<div class="section-label-row"><h2>A place for everything</h2><span>Keep your business moving</span></div>
<div class="shortcut-grid">
    <a class="shortcut-card" asp-action="Shipments"><span class="shortcut-icon">@await Html.PartialAsync("_PortalIcon", "truck")</span><div><h3>Track your shipments</h3><p>Find an order and follow its delivery history.</p></div>@await Html.PartialAsync("_PortalIcon", "external")</a>
    <a class="shortcut-card" asp-action="Products"><span class="shortcut-icon">@await Html.PartialAsync("_PortalIcon", "box")</span><div><h3>Manage your products</h3><p>Keep your catalog and stock organized.</p></div>@await Html.PartialAsync("_PortalIcon", "external")</a>
    <a class="shortcut-card" asp-action="Invoices"><span class="shortcut-icon">@await Html.PartialAsync("_PortalIcon", "invoice")</span><div><h3>Review your invoices</h3><p>Your statements and billing details together.</p></div>@await Html.PartialAsync("_PortalIcon", "external")</a>
</div>
