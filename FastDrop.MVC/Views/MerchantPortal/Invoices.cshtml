@model IEnumerable<FastDrop.MVC.Models.Invoice>

@{
    Layout = "_MerchantLayout";
    ViewData["Title"] = "Invoices";
    ViewData["Subtitle"] = "Invoices for your delivered shipments";
}

<div class="table-wrap">
    <div class="table-head">
        <div class="table-title">Invoices</div>
    </div>
    <div style="overflow-x:auto">
        <table>
            <thead>
                <tr>
                    <th>Invoice ID</th>
                    <th>Period</th>
                    <th>Amount Due</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in Model)
                {
                    var statusName = invoice.PaymentStatus ?? "Unpaid";
                    var badgeClass = statusName.Equals("Paid", StringComparison.OrdinalIgnoreCase) ? "sb-paid" : "sb-unpaid";
                    
                    <tr>
                        <td style="font-weight:700; color:var(--primary)">#INV-@invoice.InvoiceId</td>
                        <td>
                            @if(invoice.PeriodStart.HasValue && invoice.PeriodEnd.HasValue)
                            {
                                @($"{invoice.PeriodStart.Value:MMM dd} - {invoice.PeriodEnd.Value:MMM dd, yyyy}")
                            }
                            else if (invoice.ShipmentId.HasValue)
                            {
                                <span>For Shipment #@invoice.ShipmentId</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td style="font-weight:600">@invoice.AmountDue.ToString("C")</td>
                        <td><span class="s-badge @badgeClass">@statusName</span></td>
                        <td>
                            <a href="@Url.Action("InvoiceDetails", "MerchantPortal", new { id = invoice.InvoiceId })" class="btn btn-secondary btn-sm">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
                
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" style="text-align: center; padding: 24px; color: var(--text-muted);">
                            You have no invoices.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
