@model FastDrop.MVC.Models.Shipment

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Shipment</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreationDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreationDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CodAmount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CodAmount)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.WeightKg)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.WeightKg)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Warehouse)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Warehouse.WarehouseId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Merchant)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Merchant.MerchantId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Route)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Route.RouteId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Address.AddressId)
        </dd>
    </dl>
</div>
</div>
<div>
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Dispatcher"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.ShipmentId">Edit</a> <span>|</span>
    }
    <a asp-action="Index">Back to List</a>
</div>

@if (User.IsInRole("Driver") || User.IsInRole("SuperAdmin") || User.IsInRole("Dispatcher"))
{
    <hr />
    <div class="card mt-4">
        <div class="card-header bg-primary text-white">
            <h5>Update Shipment Status</h5>
        </div>
        <div class="card-body">
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model?.ShipmentId" />
                
                <div class="form-group mb-3">
                    <label class="control-label">Status</label>
                    <select name="status" class="form-control">
                        <option value="In Transit">In Transit</option>
                        <option value="Delivered">Delivered (Submit POD)</option>
                        <option value="Failed Attempt">Failed Attempt</option>
                    </select>
                </div>
                
                <div class="form-group mb-3">
                    <label class="control-label">Comments</label>
                    <input type="text" name="comments" class="form-control" placeholder="Optional comments..." />
                </div>
                
                <button type="submit" class="btn btn-success">Update Status</button>
            </form>
        </div>
    </div>
}
